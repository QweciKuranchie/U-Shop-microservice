{
  "name": "ushop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nx run-many --target=dev --all --output-style=stream",
    "build": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "type-check": "nx run-many --target=type-check --all",
    "dev:web": "nx run @repo/web:dev",
    "dev:seller": "nx run @repo/seller:dev",
    "dev:admin": "nx run @repo/admin:dev",
    "dev:studio": "nx run studio:dev",
    "db:seed": "pnpm --filter=@repo/web run db:seed",
    "db:nuke": "pnpm --filter=@repo/web run db:nuke",
    "typegen": "pnpm --filter=@repo/sanity run typegen"
  },
  "devDependencies": {
    "nx": "23.2.0",
    "@nx/next": "23.2.0",
    "@nx/eslint": "23.2.0",
    "typescript": "^5"
  }
}
