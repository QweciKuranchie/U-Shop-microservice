{
  "extends": "@repo/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ],
      "@repo/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@repo/media": [
        "../../packages/media/src/index.ts"
      ],
      "@repo/sanity": [
        "../../packages/sanity/src/index.ts"
      ],
      "@repo/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@repo/utils": [
        "../../packages/utils/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
